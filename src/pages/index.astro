---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div id="cursor" aria-hidden="true"></div>
  <div id="cursor-ring" aria-hidden="true"></div>
  <div id="warp" aria-hidden="true"><canvas id="warp-canvas"></canvas></div>

  <!-- ════════════════ INTRO (aria-hidden from crawlers) ════════════════ -->
  <div id="intro" role="presentation" aria-hidden="true">
    <canvas id="intro-canvas"></canvas>
    <div class="intro-text">
      <p class="intro-singularity">— Singularity detected —</p>
      <p class="intro-year">T = 0 &nbsp;|&nbsp; ΔE → ∞</p>
      <!-- Decorative — real H1 is in #hero below -->
      <p class="intro-name">Luca<br>Lo Cricchio</p>
      <p class="intro-tagline">Full Stack Developer · Digital Systems &amp; Marketing Automation</p>
      <div class="intro-enter">
        <button class="btn-enter" id="enterBtn">Enter the Universe →</button>
      </div>
    </div>
    <div class="intro-bar"></div>
    <div class="intro-skip" id="skipBtn" role="button" tabindex="0" aria-label="Skip intro animation">Skip intro</div>
  </div>

  <!-- ════════════════ SITE ════════════════ -->
  <div id="site">
    <canvas id="universe" aria-hidden="true"></canvas>

    <!-- NAV -->
    <nav id="mainnav" role="navigation" aria-label="Main navigation">
      <a href="#hero" class="nav-logo" aria-label="Luca Lo Cricchio — back to top">LLC.dev</a>
      <ul class="nav-links" role="list">
        <li><a href="#about">About</a></li>
        <li><a href="#story">Story</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#softskills">Soft Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#certifications">Certs</a></li>
        <li><a href="#download">CV</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <button class="nav-hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <!-- MOBILE MENU -->
    <div class="nav-mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile navigation">
      <a href="#about">About</a>
      <a href="#story">Story</a>
      <a href="#skills">Skills</a>
      <a href="#softskills">Soft Skills</a>
      <a href="#projects">Projects</a>
      <a href="#certifications">Certs</a>
      <a href="#download">CV</a>
      <a href="#contact">Contact</a>
    </div>

    <!-- ════ H1 — sole H1 of the page, in hero ════ -->
    <section id="hero" aria-labelledby="hero-h1">
      <p class="hero-eyebrow">// Portfolio v2.0 — Live</p>
      <h1 class="hero-name" id="hero-h1">
        <span class="hero-name-first">Luca</span><br>
        <span class="hero-name-last">Lo Cricchio</span>
      </h1>
      <div class="hero-typewriter-wrap" aria-live="polite" aria-atomic="true">
        <span class="hero-prefix">//</span>
        <span id="typewriter"></span>
      </div>
      <div class="hero-cta">
        <a href="#projects" class="btn-primary">Explore Projects</a>
        <a href="#contact" class="btn-ghost">Get in Touch ↗</a>
      </div>
      <div class="hero-scroll-hint" aria-hidden="true">
        <div class="scroll-line"></div>
        <span class="scroll-label">Scroll</span>
      </div>
    </section>

    <!-- ════ MAIN CONTENT wrapper — all H2s live here ════ -->
    <main id="main-content">

      <!-- ── ABOUT ────────────────────────────────── -->
      <section id="about" aria-labelledby="about-h2">
        <div class="about-grid">
          <div class="reveal-left">
            <p class="section-label">About</p>
            <!-- H2: section title -->
            <h2 class="scramble-heading" id="about-h2" data-text="I don't write code.<br>I architect systems.">I don't write code.<br>I architect systems.</h2>
            <p class="about-text">I'm <strong>Luca Lo Cricchio</strong> — a Full Stack Developer from Monza, Italy. While most people my age were still figuring out HTML, I was already building real digital systems. I didn't wait for permission. I started doing.</p>
            <p class="about-text">My approach is that of a <strong>digital architect</strong>: I think in full systems before writing a single line. From front-end to back-end, from relational databases to advertising campaigns, from automation to the creative direction of a game studio — every piece has to fit perfectly.</p>
            <p class="about-text">I've already worked with real clients, managed campaigns reaching thousands of impressions, and co-founded a video game studio. This isn't ambition — it's already history.</p>
            <div class="about-stats" role="list">
              <div class="stat-card" role="listitem">
                <div class="stat-num counter" data-target="6">0</div>
                <div class="stat-desc">Projects shipped</div>
              </div>
              <div class="stat-card" role="listitem">
                <div class="stat-num">15+</div>
                <div class="stat-desc">Certifications</div>
              </div>
              <div class="stat-card" role="listitem">
                <div class="stat-num counter" data-target="5">0</div>
                <div class="stat-desc">Years of study</div>
              </div>
              <div class="stat-card" role="listitem">
                <div class="stat-num counter" data-target="100" data-suffix="%">0%</div>
                <div class="stat-desc">Committed</div>
              </div>
            </div>
          </div>
          <div class="about-visual reveal-right">
            <div class="about-photo-wrap">
              <div class="about-photo-frame">
                <img
                  class="about-photo"
                  src="profile-photo.jpg"
                  alt="Luca Lo Cricchio — Full Stack Developer from Monza, Italy"
                  width="380" height="507"
                  loading="eager"
                  fetchpriority="high"
                >
                <div class="about-photo-tag">
                  <span>Monza, Italy · 2026</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── STORY ────────────────────────────────── -->
      <section id="story" aria-labelledby="story-h2">
        <div class="story-inner">
          <div class="story-header reveal">
            <p class="section-label">Origin Story</p>
            <!-- H2 -->
            <h2 class="scramble-heading" id="story-h2" data-text="How a developer<br>is forged">How a developer<br>is forged</h2>
          </div>
          <div class="story-body">

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2021">2021</time></div>
              <div class="story-content">
                <!-- H3: subsection under story H2 -->
                <h3>The beginning: ITIS Ettore Molinari</h3>
                <p>At 14 I enrolled at ITIS Ettore Molinari in Milan to study Computer Science. I immediately understood that school is a launchpad, not a ceiling. Every concept learned in class became a brick for building something real outside.</p>
              </div>
            </div>

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2023">2023</time></div>
              <div class="story-content">
                <h3>LSD Software Studio: building worlds</h3>
                <p>In November 2023 I co-founded <strong>LSD Software</strong> — a video game studio. I became lead developer and creative director. Not theory: real production. I shipped <em>Card Game</em>, a casino-themed guess game, and <em>P-E-S-C-A</em>, an original point &amp; click adventure.</p>
                <p>Learning to manage a creative project, coordinate a vision, and turn an idea into a product people can actually play — that was my first real lesson in leadership.</p>
              </div>
            </div>

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2024">2024</time></div>
              <div class="story-content">
                <h3>The real world: internship at EUDEMONIA SRL</h3>
                <p>June 2024. First real internship, first company, first real client. At <strong>EUDEMONIA SRL</strong> I managed campaigns on Google Ads, Meta Business Suite and Amazon Business. I analysed traffic data, optimised performance, and built <em>idraulicoservizi.com</em> from scratch with WordPress and SEO.</p>
                <p>I discovered that code is only half the game. The other half is understanding what the client wants, what their audience searches for, and how to translate data into decisions.</p>
              </div>
            </div>

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2024">2024–25</time></div>
              <div class="story-content">
                <h3>Certifications, expansion, new horizons</h3>
                <p>While others sleep, I study. Oracle Academy, Cisco, Sorint.Lab: database design, networking, Python, React Native, Docker, AWS, web security, AI for developers. Every certification isn't a badge — it's another tool in the kit.</p>
                <p>I shipped <em>LSD Console</em>, a 2D home-console-style title, and started <strong>Project Arcana</strong>, a psychological 3D story-driven game. The technical complexity rises — and so do I.</p>
              </div>
            </div>

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2025">2025</time></div>
              <div class="story-content">
                <h3>Back in the field: impresaedileabilart.com</h3>
                <p>Second internship at EUDEMONIA. This time I managed everything independently: site structure, SEO content, advertising campaigns and direct client contact. <em>impresaedileabilart.com</em> went live — a complete digital system conceived and built by me.</p>
              </div>
            </div>

            <div class="story-block reveal">
              <div class="story-year"><time datetime="2026">2026</time></div>
              <div class="story-content">
                <h3>Diploma and next chapter</h3>
                <p>July 2026: Computer Science diploma from ITIS Ettore Molinari. The diploma is a starting point, not a finish line. I already have skills that most people chase for years, real-world experience, and a portfolio that speaks for itself.</p>
                <p>The next chapter is being written right now. And it will be the most interesting one yet.</p>
              </div>
            </div>

            <div class="story-block reveal story-present">
              <div class="story-year"><time datetime="2026">2026 — Now</time></div>
              <div class="story-content">
                <h3>AI Engineering: building intelligent systems</h3>
                <p>In September 2026, I joined <strong>HQ Engineering</strong> as an AI Junior Developer. My work focuses on building intelligent systems, AI-powered automations, software infrastructure and digital services.</p>
                <p>I work across Full Stack development, OCR and document processing, locally deployed AI models, SaaS applications and smart automation systems. My goal is to turn complex workflows into practical, integrated solutions.</p>
                <p>This marks the next step in my journey: moving from independent projects to developing technology-driven solutions in a professional environment.</p>
              </div>
            </div>


          </div>
        </div>
      </section>

      <!-- ── SKILLS ───────────────────────────────── -->
