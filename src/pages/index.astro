      <!-- ── SOFT SKILLS ──────────────────────────── -->
      <section id="softskills" aria-labelledby="soft-h2">
        <div class="soft-header reveal">
          <p class="section-label" style="justify-content:center;">Human first</p>
          <!-- H2 -->
